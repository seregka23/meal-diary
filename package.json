{
  "name": "meal-diary",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:scaffold && npm run test --workspaces --if-present",
    "test:scaffold": "node --test test/scaffold.test.mjs",
    "start:api": "npm --workspace @meal-diary/api run start:dev",
    "start:web": "npm --workspace @meal-diary/web run start"
  }
}
